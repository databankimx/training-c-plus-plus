{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build active file",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++23",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Builds the active C++ file with MSYS2 g++ (Ctrl+Shift+B)."
        },
        {
            "label": "C/C++: run active file",
            "type": "shell",
            "command": "${fileDirname}\\${fileBasenameNoExtension}.exe",
            "dependsOn": "C/C++: g++ build active file",
            "dependsOrder": "sequence",
            "options": {
                "cwd": "${fileDirname}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "detail": "Builds the active C++ file, then runs it in the terminal."
        },
        {
            "label": "C/C++: configure lesson (CMake)",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S",
                "${fileDirname}/..",
                "-B",
                "${fileDirname}/../build",
                "-G",
                "Ninja",
                "-DCMAKE_CXX_COMPILER=g++"
            ],
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "clear": false
            },
            "problemMatcher": [],
            "detail": "Configures the lesson's CMake project, for a lesson with several source files."
        },
        {
            "label": "C/C++: build lesson (CMake)",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "${fileDirname}/../build"
            ],
            "dependsOn": "C/C++: configure lesson (CMake)",
            "dependsOrder": "sequence",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Builds every source file in the lesson's CMake project, for a lesson with several source files."
        },
        {
            "label": "C/C++: run lesson (CMake)",
            "type": "process",
            "command": "${fileDirname}/../build/program.exe",
            "dependsOn": "C/C++: build lesson (CMake)",
            "dependsOrder": "sequence",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": false
            },
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "detail": "Builds the lesson's CMake project, then runs its program in the terminal."
        }
    ],
    "version": "2.0.0"
}
